 		int res = 1;                                  \
 		errors_file = fopen("errors.log", "w");       \
+		setvbuf(errors_file, NULL, _IONBF, 0);        \
 		reset_malloc_mock();                          \
 		code;                                         \
 		fclose(errors_file);                          \
diff --git a/tests/printf/fsoares/Makefile b/tests/printf/fsoares/Makefile
index 2d4da9d..943135e 100644
--- a/tests/printf/fsoares/Makefile
+++ b/tests/printf/fsoares/Makefile
@@ -9,6 +9,16 @@ ifdef EXEC_STRICT
 STRICT		= -D STRICT_MEM
 endif
 
+# paco: on Linux, AddressSanitizer runs its interceptor setup (which calls
+# malloc) before it maps its shadow memory, so the instrumented malloc mock
+# in utils/malloc_mock.c segfaulted the test binary before main() - and the
+# silent crash was reported as "all tests passed". Leaks are still caught by
+# the malloc mock itself; francinette already drops ASan on Linux for the
+# same reason everywhere else (see add_sanitizer_to_makefiles).
+ifeq ($(shell uname -s),Linux)
+CFLAGS		:= $(filter-out -fsanitize=address,$(CFLAGS))
+endif
+
 # SDK headers shipping w/Xcode 14.1 (22/11/01)
 # and later deprecate some functions used here
 CFLAGS		+= -Wno-deprecated-declarations
