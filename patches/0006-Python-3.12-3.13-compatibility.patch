From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sanlega <santilega@gmail.com>
Date: Fri, 2 Oct 2026 14:30:08 +0000
Subject: [PATCH 06/10] Python 3.12/3.13 compatibility

- 'pipes' was removed in Python 3.13: use shlex.quote (same function).
- Raw strings for regexes, which Python 3.12+ otherwise reports with a
  SyntaxWarning printed in the middle of the test output.
- Logger.warn -> Logger.warning (deprecated alias).
---
 testers/BaseTester.py       |  6 +++---
 testers/libft/Fsoares.py    | 12 +++++++-----
 testers/minitalk/Fsoares.py |  4 ++--
 testers/pipex/Fsoares.py    |  2 +-
 testers/pipex/Medic.py      |  2 +-
 testers/pipex/Vfurname.py   |  2 +-
 utils/LeaksCheck.py         |  2 +-
 7 files changed, 16 insertions(+), 14 deletions(-)

diff --git a/testers/BaseTester.py b/testers/BaseTester.py
index af0c2c3..92e0d4b 100644
--- a/testers/BaseTester.py
+++ b/testers/BaseTester.py
@@ -230,15 +230,15 @@ class BaseTester:
 
 		print(f"\n{TC.B_CYAN}Summary{TC.NC}: {'' if has_bonus() else 'no bonus'}")
 
-		logger.warn(f"norminette errors: {norm_errors}")
+		logger.warning(f"norminette errors: {norm_errors}")
 		if norm_errors:
 			print(f"\n{TC.B_YELLOW}Norminette Errors{TC.NC}:", ', '.join(norm_errors))
 
-		logger.warn(f"missing functions: {missing}")
+		logger.warning(f"missing functions: {missing}")
 		if missing:
 			print(f"\n{TC.B_YELLOW}Missing functions{TC.NC}: {', '.join(missing)}")
 
-		logger.warn(f"errors in functions: {errors}")
+		logger.warning(f"errors in functions: {errors}")
 		if error_funcs:
 			print(f"\n{TC.B_RED}Failed tests{TC.NC}: {', '.join(error_funcs)}")
 
